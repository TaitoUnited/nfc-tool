/* The screen */
"Demo: tag taps are simulated, no real tag." = "Demo: tagin kosketukset ovat simuloituja, oikeaa tagia ei ole.";
"This device cannot write NFC tags." = "Tällä laitteella ei voi kirjoittaa NFC-tageihin.";
"Content" = "Sisältö";
"A link, text, phone number or email" = "Linkki, teksti, puhelinnumero tai sähköposti";
"A phone that touches the tag opens a link, offers to call or email, or gets the text. The app keeps what you type on this phone." = "Puhelin, joka koskettaa tagia, avaa linkin, tarjoutuu soittamaan tai lähettämään sähköpostia tai saa tekstin. Sovellus säilyttää kirjoittamasi tässä puhelimessa.";
"Last result" = "Viimeisin tulos";
"Passphrase" = "Salasana";
"Remember on this phone" = "Muista tässä puhelimessa";
"Saved in this phone's keychain. Protecting a tag, removing its protection and rewriting a protected tag need the passphrase." = "Tallennettu tämän puhelimen avainnippuun. Tagin suojaaminen, suojauksen poistaminen ja suojatun tagin uudelleenkirjoittaminen vaativat salasanan.";
"Protecting a tag, removing its protection and rewriting a protected tag need it. The app saves it only while Remember is on." = "Tagin suojaaminen, suojauksen poistaminen ja suojatun tagin uudelleenkirjoittaminen vaativat sen. Sovellus tallentaa sen vain, kun Muista on päällä.";
"Protect" = "Suojaus";
"Protect the tag" = "Suojaa tag";
"Remove the protection" = "Poista suojaus";
"Protect locks the tag so only this passphrase can rewrite it. Phones still read it. Remove the protection to make it writable again." = "Suojaus lukitsee tagin niin, että vain tällä salasanalla voi kirjoittaa sen uudelleen. Puhelimet lukevat sen silti. Poista suojaus, niin tagiin voi taas kirjoittaa.";
"Write to the tag" = "Kirjoita tagiin";
"Done" = "Valmis";
"Remember the passphrase \"%@\". Without it, nobody can change the tag again, you included." = "Muista salasana \"%@\". Ilman sitä kukaan ei voi enää muuttaa tagia, et sinäkään.";
"Simulated tag tap" = "Simuloitu tagin kosketus";

/* What a phone does with the content */
"Writes this as text. A phone shows it only in an app that reads NFC tags." = "Kirjoittaa tämän tekstinä. Puhelin näyttää sen vain sovelluksessa, joka lukee NFC-tageja.";
"Phones offer to email %@." = "Puhelimet tarjoutuvat lähettämään sähköpostia osoitteeseen %@.";
"Phones offer to call %@." = "Puhelimet tarjoutuvat soittamaan numeroon %@.";
"Phones open %@." = "Puhelimet avaavat osoitteen %@.";
"%lld bytes, fits an NTAG213, 215 or 216." = "%lld tavua, mahtuu NTAG213-, NTAG215- tai NTAG216-tagiin.";
"%lld bytes, needs an NTAG215 or 216." = "%lld tavua, vaatii NTAG215- tai NTAG216-tagin.";
"%lld bytes, needs an NTAG216." = "%lld tavua, vaatii NTAG216-tagin.";
"%lld bytes, too long for an NTAG216, which takes 868." = "%lld tavua, liian pitkä NTAG216-tagiin, johon mahtuu 868.";

/* Tag taps */
"Hold the top of the iPhone on the tag." = "Pidä iPhonen yläreunaa tagin päällä.";
"Hold the top of the iPhone on the tag to protect it." = "Pidä iPhonen yläreunaa tagin päällä suojataksesi sen.";
"Hold the top of the iPhone on the tag to remove its protection." = "Pidä iPhonen yläreunaa tagin päällä poistaaksesi sen suojauksen.";
"More than one tag found. Hold just one." = "Löytyi useampi kuin yksi tag. Pidä vain yhtä.";
"Wrote the tag. Test it before you protect it." = "Tag kirjoitettu. Testaa se ennen kuin suojaat sen.";
"Protected the tag. Phones still read it." = "Tag suojattu. Puhelimet lukevat sen silti.";
"This tag does not hold what is typed above, so it stays unprotected." = "Tagissa ei ole yllä kirjoitettua sisältöä, joten se jää suojaamatta.";
"This tag cannot hold NFC content." = "Tähän tagiin ei voi tallentaa NFC-sisältöä.";
"Removed the protection. Anyone can rewrite the tag now." = "Suojaus poistettu. Kuka tahansa voi nyt kirjoittaa tagin uudelleen.";
"This tag is protected. Type its passphrase first." = "Tag on suojattu. Kirjoita ensin sen salasana.";
"Wrong passphrase. The tag stays as it was." = "Väärä salasana. Tag pysyy ennallaan.";
"Wrong passphrase. The tag stays protected." = "Väärä salasana. Tag pysyy suojattuna.";
"This tag is protected already." = "Tag on jo suojattu.";
"This tag has no protection to remove." = "Tagissa ei ole poistettavaa suojausta.";
"This is not an NTAG213, 215 or 216 tag." = "Tämä ei ole NTAG213-, NTAG215- tai NTAG216-tag.";
"This takes %lld bytes, the tag holds %lld." = "Tämä vie %lld tavua, tagiin mahtuu %lld.";
"Could not read the tag's settings." = "Tagin asetuksia ei voitu lukea.";
"Could not encode this for the tag." = "Tätä ei voitu muuntaa tagille sopivaksi.";
"This tag is locked for good." = "Tag on lukittu pysyvästi.";
"Could not set the password." = "Salasanaa ei voitu asettaa.";
"Could not set the protection." = "Suojausta ei voitu asettaa.";
"Could not turn the protection on." = "Suojausta ei voitu ottaa käyttöön.";
"The protection did not take." = "Suojaus ei jäänyt voimaan.";
"Could not remove the protection." = "Suojausta ei voitu poistaa.";
"The protection is still on." = "Suojaus on yhä päällä.";
"Clear" = "Tyhjennä";
